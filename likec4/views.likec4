// Views for the ArthaAI model. Open with: Ctrl+Shift+P → "LikeC4: Open Preview".

views {

  // Whole-system context (people, ArthaAI, external systems, stores).
  view index {
    title 'ArthaAI — system context'
    include *
    autoLayout TopBottom
  }

  // ArthaAI's containers and their dependencies.
  view containers {
    title 'ArthaAI — containers'
    include arthaai
    include arthaai.*
    include * -> *
  }

  // The agent fan-out converging at the Master LLM, then sizing.
  view agents {
    title 'Agents — fan-out → converge → sizing'
    include arthaai.orchestrator
    include arthaai.agents.*
    include * -> *
  }

  // Ingestion providers and the stores they touch.
  view data {
    title 'Data ingestion & stores'
    include arthaai.ingestion.*
    include arthaai.agents.db_agent
    include arthaai.agents.quant_agent
    include arthaai.agents.news_agent
    include timescale
    include qdrant
    include redpanda
    include yfinance
    include lse
    include edgar
    include fred
    include * -> *
  }

  // The Master LLM provider chain and its fallback target.
  view llm {
    title 'Master LLM — provider chain'
    include arthaai.agents.master_llm
    include anthropic
    include gemini
    include local_llm
    include vault
    include * -> *
  }

  // Edge / ingress, auth, mTLS, and policy.
  view edge {
    title 'Edge, auth & policy'
    include arthaai.gateway.*
    include arthaai.gateway
    include arthaai.security
    include opa
    include vault
    include * -> *
  }

  // Evaluation / backtest path (E3).
  view evaluation {
    title 'Evaluation — backtest, factors, promotion'
    include arthaai.backtest
    include arthaai.factors.*
    include timescale
    include arthaai.cli
    include * -> *
  }

  // Deployment of the local docker-compose stack (model in deployment.likec4).
  deployment view deploymentLocal {
    title 'Deployment — local stack (docker compose)'
    include *
    autoLayout LeftRight
  }

  // ---- dynamic flows -------------------------------------------------------

  dynamic view analyzeFlow {
    title 'analyze() — fan-out → converge → sizing'
    operator -> arthaai.cli 'arthaai analyze GLD'
    arthaai.cli -> arthaai.orchestrator 'analyze()'
    arthaai.orchestrator -> arthaai.ingestion 'ingest_resilient (skipped with --skip-ingest)'
    arthaai.orchestrator -> arthaai.agents.db_agent 'db_agent.run'
    arthaai.orchestrator -> arthaai.agents.quant_agent 'quant_agent.run'
    arthaai.orchestrator -> arthaai.agents.news_agent 'news_agent.run'
    arthaai.agents.db_agent -> timescale 'load_ohlcv'
    arthaai.agents.news_agent -> qdrant 'hybrid_search'
    arthaai.agents.quant_agent -> arthaai.factors.registry 'factor signal'
    arthaai.agents.master_llm -> local_llm 'complete (anthropic → gemini → local → offline)'
    arthaai.agents.master_llm -> arthaai.agents.asset_manager 'verdict + confidence'
    arthaai.agents.asset_manager -> arthaai.cli 'allocation (discrete Kelly + cap)'
  }

  dynamic view executeFlow {
    title 'execute() — paper order with mandatory stop'
    operator -> arthaai.cli 'arthaai execute GLD'
    arthaai.cli -> arthaai.orchestrator 'analyze()'
    arthaai.cli -> arthaai.security 'authorize_tool(kelly)'
    arthaai.security -> opa 'allow?'
    arthaai.cli -> arthaai.execution 'engine.submit — PAPER (no broker)'
    arthaai.execution -> arthaai.cli 'order + 8% stop (breaker armed)'
  }

  dynamic view e3Flow {
    title 'E3 promotion gate — sweep the frozen universe'
    operator -> arthaai.cli 'promote-sweep --signal … --no-save'
    arthaai.cli -> arthaai.backtest 'run_backtest over non-overlapping OOS windows'
    arthaai.backtest -> timescale 'load_ohlcv'
    arthaai.backtest -> arthaai.factors.registry 'signal_series (composite / ic_composite)'
    arthaai.backtest -> arthaai.cli 'qualified? — 0/73 (all variants)'
  }
}
