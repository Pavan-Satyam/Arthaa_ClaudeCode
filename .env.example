# Copy to .env and fill in. .env is git-ignored.

# --- TimescaleDB ---
ARTHAAI_TIMESCALE_HOST=localhost
ARTHAAI_TIMESCALE_PORT=5432
ARTHAAI_TIMESCALE_DB=arthaai
ARTHAAI_TIMESCALE_USER=arthaai
ARTHAAI_TIMESCALE_PASSWORD=arthaai_dev_pw

# --- Qdrant ---
ARTHAAI_QDRANT_HOST=localhost
ARTHAAI_QDRANT_PORT=6333

# --- Kafka / Redpanda event bus ---
ARTHAAI_KAFKA_BOOTSTRAP=localhost:9092

# --- Zero-trust infra (OPA policy engine + Vault secrets) ---
ARTHAAI_OPA_URL=http://localhost:8181
ARTHAAI_VAULT_ADDR=http://localhost:8200
ARTHAAI_VAULT_TOKEN=arthaai-root
# Gateway bearer token — stored in Vault by `arthaai seed-secrets`; env is the fallback.
ARTHAAI_GATEWAY_TOKEN=dev-token

# --- Master Reasoning LLM ---
# Provider chain, tried in order; always ends at the deterministic offline reasoner.
# Examples:  gemini,local,offline   |   local,offline   |   anthropic,gemini,offline
# If ARTHAAI_LLM_CHAIN is empty, the chain is [ARTHAAI_LLM_PROVIDER, offline].
ARTHAAI_LLM_PROVIDER=anthropic
ARTHAAI_LLM_CHAIN=

# anthropic (Claude)
ARTHAAI_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# gemini (Google) — get a key at https://aistudio.google.com/apikey
ARTHAAI_GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# local (OpenAI-compatible: Ollama / LM Studio / vLLM)
#   e.g. `ollama serve` then `ollama pull llama3.1`
ARTHAAI_LOCAL_BASE_URL=http://localhost:11434/v1
ARTHAAI_LOCAL_MODEL=llama3.1
ARTHAAI_LOCAL_API_KEY=

# --- Asset Manager risk policy ---
ARTHAAI_KELLY_FRACTION=0.25
ARTHAAI_MAX_SINGLE_INSTRUMENT=0.05
ARTHAAI_RISK_FREE_RATE=0.04
