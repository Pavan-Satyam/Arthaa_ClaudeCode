# Copy to .env and fill in. .env is git-ignored.

# --- TimescaleDB ---
ARTHAAI_TIMESCALE_HOST=localhost
ARTHAAI_TIMESCALE_PORT=5432
ARTHAAI_TIMESCALE_DB=arthaai
ARTHAAI_TIMESCALE_USER=arthaai
ARTHAAI_TIMESCALE_PASSWORD=arthaai_dev_pw

# --- Qdrant ---
ARTHAAI_QDRANT_HOST=localhost
ARTHAAI_QDRANT_PORT=6333

# --- Kafka / Redpanda event bus ---
ARTHAAI_KAFKA_BOOTSTRAP=localhost:9092

# --- Master Reasoning LLM ---
# With no key, the pipeline falls back to a deterministic offline reasoner
# (mirrors the blueprint's "fallback to internally-hosted model" resilience pattern).
ARTHAAI_LLM_PROVIDER=anthropic
ARTHAAI_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Asset Manager risk policy ---
ARTHAAI_KELLY_FRACTION=0.25
ARTHAAI_MAX_SINGLE_INSTRUMENT=0.05
ARTHAAI_RISK_FREE_RATE=0.04
